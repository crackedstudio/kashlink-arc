# All of these are baked in at build time (VITE_ prefix), so changing one means a redeploy.

# Which Arc network to use: `mainnet` (chain 5042) or `testnet` (chain 5042002).
# Defaults: testnet in `npm run dev`, mainnet in production builds.
# VITE_ARC_NETWORK=testnet

# The KashLinkEscrow contract on that network. See contracts/deployments.md. Without it the app
# opens but refuses to create links.
VITE_ESCROW_ADDRESS=0xb66527AeBF350eA229829b12b8BBFdE88944d65b

# Block the contract was deployed in — lets "your links from other devices" scan only from there.
# VITE_ESCROW_DEPLOY_BLOCK=62559727

# Public HTTPS URL the shared links point to (e.g. https://kashlink.example.com). Defaults to the
# URL the app was loaded from.
# VITE_PUBLIC_URL=

# Optional: a dedicated Arc RPC. The default public one has no uptime guarantee.
# VITE_ARC_RPC_URL=

# Supabase project for usage analytics (see supabase/schema.sql). Leave both unset to disable
# tracking entirely — the app works the same without them. Use the *anon* key, never service_role:
# this key ships inside the app bundle, and row-level security limits it to appending events.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=
