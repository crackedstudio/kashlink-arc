# Copy to contracts/.env — it is git-ignored. Never put a private key in here for mainnet; use a
# Foundry keystore instead (`cast wallet import arc-mainnet --interactive`, then `--account arc-mainnet`).

ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Deploy.s.sol parameters. Fee: 1% with a 0.10 USDC floor, native 18-decimal units.
TREASURY=0x0000000000000000000000000000000000000000
FEE_BPS=100
FEE_MIN=100000000000000000
